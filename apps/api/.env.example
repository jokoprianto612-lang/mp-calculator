# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://mp_calculator:mp_calculator_dev@localhost:5432/mp_calculator?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=your-super-secret-cookie-key-min-32-characters-long-dev
COOKIE_DOMAIN=
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:5173

# DeepL Translation
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/oauth/github/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# File Upload
MAX_FILE_SIZE=5242880

# Encryption
ENCRYPTION_KEY=