{
  "name": "@mp-calculator/shared",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./fee-engine": {
      "types": "./dist/fee-engine.d.ts",
      "import": "./dist/fee-engine.js",
      "require": "./dist/fee-engine.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "import": "./dist/validation.js",
      "require": "./dist/validation.js"
    }
  },
  "scripts": {
        "build": "pnpm exec tsc",
        "dev": "pnpm exec tsc --watch",
        "lint": "eslint src --ext .ts",
        "test": "vitest run",
        "typecheck": "pnpm exec tsc --noEmit",
        "clean": "rm -rf dist"
      },
  "dependencies": {
    "zod": "^3.22.0",
    "decimal.js": "^10.4.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^1.3.0",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0"
  }
}